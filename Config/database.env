# ============================================
# Oracle 数据库连接配置
# SBMES 项目 - 数据库连接信息
# ============================================
# 使用说明：
# 1. 复制此文件为 database.env（去掉 .sample 后缀）
# 2. 填写实际的数据库连接信息
# 3. 该文件已被 .gitignore 忽略，不会提交到版本控制
# ============================================
# 安全提示：
# - 本文件仅供本地开发使用
# - 正式密码请妥善保管，不要泄露
# - 当前默认配置为【只读权限】，禁止执行 INSERT/UPDATE/DELETE/DROP 等操作
# - 如需调整权限（如开发环境需要写权限），请修改对应环境的 ORACLE_ROLE
# ============================================


# --------------------------------------------
# 【测试环境】
# --------------------------------------------
ORACLE_TEST_HOST=192.168.188.1
ORACLE_TEST_PORT=5432
ORACLE_TEST_SERVICE=zytool
ORACLE_TEST_CONN_TYPE=SERVICE_NAME
ORACLE_TEST_USER=postgres
ORACLE_TEST_PASSWORD=3412zxc567

# 测试环境开发调试时使用 DEVELOPER 权限
ORACLE_TEST_ROLE=DEVELOPER

# --------------------------------------------
# 【其他配置】
# --------------------------------------------
# Oracle 客户端字符集
ORACLE_CHARSET=AL32UTF8

# 连接超时时间（秒）
ORACLE_TIMEOUT=30

# 是否开启 SQL 执行日志（true/false）
ORACLE_QUERY_LOG=true

# 日志输出目录（相对路径）
ORACLE_LOG_DIR=./logs
